# ============================================================
# YourSeha — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values from Supabase.
# NEVER commit .env to GitHub — it's in .gitignore already.
# ============================================================

# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for npm run db:apply-rls (fixes psychologist_availability RLS)
# Supabase → Settings → Database → Connection string → URI (include password)
# DATABASE_URL=postgresql://postgres.[ref]:PASSWORD@aws-0-....pooler.supabase.com:6543/postgres
